# Optional. Copy to `.env.development` / `.env.production` when you have
# per-environment values to set; both are gitignored, and a build works
# without them. Only NEXT_PUBLIC_* vars reach the client bundle — never put a
# real secret here. Everything the site reads is declared in `src/lib/env.ts`.
#
# The stage is NOT read from this file at build time: `npm run build` and
# `npm run build:prod` each pass it on the command line, and the host for each
# stage lives in SITE_URLS in `src/lib/env.ts`. That is what lets CI build
# without any env file present.

# development | production
# Only used by `next dev`. Decides whether the build may be indexed at all:
# production is indexable, development ships `noindex, nofollow` plus a
# robots.txt that disallows everything.
NEXT_PUBLIC_APP_STAGE=production

# Overrides the host the stage would pick — for a preview served from
# somewhere other than the two deployments. Must be exact: scheme included,
# no trailing slash. Only honoured from this file, not from the ambient
# environment, so a stray value can't retarget a build.
#   development  https://dev.xpertoneindia.com
#   production   https://xpertoneindia.com
# NEXT_PUBLIC_SITE_URL=

# Google Analytics measurement ID (G-XXXXXXXXXX). The tag loads only on the
# production stage, so leaving this set is safe for the dev build.
NEXT_PUBLIC_GA_ID=

# Public, rate-limited intake endpoint for the demo form. Ships in the client
# bundle, so it must never be a private Slack/Zapier webhook.
# Leave empty to log submissions to the browser console instead.
NEXT_PUBLIC_LEAD_ENDPOINT=
