# Copy to `.env.development` / `.env.production` and fill in.
# Only NEXT_PUBLIC_* vars reach the client bundle — never put a real secret
# here. Everything the site reads is declared in `src/lib/env.ts`.

# development | production
# Decides whether the build may be indexed at all: production is indexable,
# development ships `noindex, nofollow` plus a robots.txt that disallows
# everything. `next dev` loads .env.development, `next build` loads
# .env.production; the build:* scripts override the stage inline.
NEXT_PUBLIC_APP_STAGE=production

# The host this build is deployed to. Canonical URLs, the sitemap, robots.txt
# and the JSON-LD @ids are all derived from it, so it must be exact — scheme
# included, no trailing slash.
#   development  https://dev.xpertoneindia.com
#   production   https://xpertoneindia.com
NEXT_PUBLIC_SITE_URL=https://xpertoneindia.com

# Public, rate-limited intake endpoint for the demo form. Ships in the client
# bundle, so it must never be a private Slack/Zapier webhook.
# Leave empty to log submissions to the browser console instead.
NEXT_PUBLIC_LEAD_ENDPOINT=
