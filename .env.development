# Development deployment
# Loaded by `next dev`; forced by `npm run build` for the dev artefact.
#
# Served as a noindex build: robots.txt disallows everything and every page
# carries `noindex, nofollow`, so it cannot compete with production in search.

NEXT_PUBLIC_APP_STAGE=development
NEXT_PUBLIC_SITE_URL=https://dev.xpertoneindia.com

NEXT_PUBLIC_LEAD_ENDPOINT=
